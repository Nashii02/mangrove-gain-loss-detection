YEARS = [2019, 2020, 2021, 2022, 2023, 2024]
START, END = "-02-01", "-04-30"      # fixed dry-season window, same every year

def prep(img):
    """One scene → masked, scaled, resampled, NDVI-added 5-band image."""
    # 1) Mask clouds / shadows / cirrus using the Scene Classification Layer
    scl = img.select("SCL")
    bad = scl.eq(3).Or(scl.eq(8)).Or(scl.eq(9)).Or(scl.eq(10))   # shadow, cloud, cloud, cirrus
    img = img.updateMask(bad.Not())

    # 2) Scale 10 m bands to reflectance 0–1
    b3  = img.select("B3").divide(10000)
    b4  = img.select("B4").divide(10000)
    b8  = img.select("B8").divide(10000)

    # 3) B11 native 20 m → bilinear resample to the 10 m grid
    b11 = img.select("B11").resample("bilinear").divide(10000)

    # 4) NDVI, rescaled to 0–1
    ndvi = (b8.subtract(b4).divide(b8.add(b4))
              .multiply(0.5).add(0.5).rename("NDVI"))

    return b3.addBands([b4, b8, b11, ndvi])    # B3, B4, B8, B11, NDVI

